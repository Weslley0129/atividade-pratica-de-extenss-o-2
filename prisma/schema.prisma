// Schema do banco de dados do Clique Saúde.
// SQLite em desenvolvimento (arquivo local, sem infraestrutura extra);
// basta trocar "provider"/"url" para "postgresql" em produção — o resto
// do schema não muda, é essa a vantagem de usar um ORM (Prisma).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Usuario {
  id        Int        @id @default(autoincrement())
  nome      String
  email     String     @unique
  senha     String
  tipo      String     @default("paciente") // "paciente" | "admin"
  criadoEm  DateTime   @default(now())
  consultas Consulta[]

  @@map("usuarios")
}

model Medico {
  id            Int                 @id @default(autoincrement())
  nome          String
  crm           String              @unique
  especialidade String
  valorConsulta Float
  criadoEm      DateTime            @default(now())
  horarios      HorarioDisponivel[]
  consultas     Consulta[]

  @@index([especialidade])
  @@map("medicos")
}

model HorarioDisponivel {
  id        Int    @id @default(autoincrement())
  medicoId  Int
  medico    Medico @relation(fields: [medicoId], references: [id], onDelete: Cascade)
  diaSemana String
  horario   String

  @@index([medicoId])
  @@map("horarios_disponiveis")
}

model Consulta {
  id          Int      @id @default(autoincrement())
  pacienteId  Int
  paciente    Usuario  @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  medicoId    Int
  medico      Medico   @relation(fields: [medicoId], references: [id], onDelete: Cascade)
  data        String
  hora        String
  status      String   @default("Agendado") // "Agendado" | "Realizado" | "Cancelado"
  observacoes String?
  criadoEm    DateTime @default(now())

  // Índice composto: acelera a checagem de disponibilidade
  // (a regra "não pode haver 2 consultas Agendadas no mesmo horário"
  // fica no service, não aqui, porque SQLite/Prisma não suportam bem
  // unique index parcial condicionado ao status).
  @@index([medicoId, data, hora])
  @@map("consultas")
}
